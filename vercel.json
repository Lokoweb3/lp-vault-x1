{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run web:build",
  "outputDirectory": "web/public",
  "functions": {
    "api/pin.ts": {
      "maxDuration": 60
    },
    "api/art/[file].ts": {
      "maxDuration": 30
    },
    "api/key/[file].ts": {
      "maxDuration": 30
    },
    "api/x1vault/[file].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/dex",
      "destination": "https://lokodex.vercel.app/dex"
    },
    {
      "source": "/dex/:path*",
      "destination": "https://lokodex.vercel.app/dex/:path*"
    }
  ]
}
